
# ==========================================
# OpenAI Configuration
# ==========================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ==========================================
# JEV Intent Classification (OpenCode Zen)
# ==========================================
OPENCODE_API_KEY=

# ==========================================
# FastOCR Configuration
# ==========================================
FASTOCR_API_KEY=
FASTOCR_BASE_URL=https://api.fastocr.org
FASTOCR_TIMEOUT_SECONDS=300

# ==========================================
# LangSmith Configuration
# ==========================================
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# ==========================================
# OCR Configuration
# ==========================================
OCR_ENGINE=fastocr
OCR_LANGS=
RENDER_DPI=300
MIN_NATIVE_CHARS=50
OCR_ALL_PAGES=false
OCR_MERGE_WITH_NATIVE=true
TESSERACT_CMD=

# ==========================================
# Jina AI Embeddings and Reranking
# ==========================================
JINA_API_KEY=
JINA_API_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_EMBEDDING_DIMENSIONS=2048
JINA_EMBEDDING_BATCH_SIZE=64
JINA_API_TIMEOUT_SECONDS=90
JINA_RERANKER_MODEL=jina-reranker-v3.5
RERANKER_SCORE_THRESHOLD=0.30

# ==========================================
# Qdrant Configuration
# ==========================================
QDRANT_API_KEY=
QDRANT_API_ENDPOINT=
QDRANT_COLLECTION_NAME=
QDRANT_SUMMARY_COLLECTION_NAME=

# ==========================================
# Aiven PostgreSQL Configuration
# ==========================================
AIVEN_POSTGRES_URI=

# ==========================================
# Aiven Redis Configuration
# ==========================================
AIVEN_REDIS_URI=
CONVERSATION_HISTORY_TTL_SECONDS=1800
CONVERSATION_HISTORY_MAX_TURNS=10

# ==========================================
# Backblaze B2 Configuration
# ==========================================
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT_URL=
B2_STORAGE_PREFIX=voice-ai/
